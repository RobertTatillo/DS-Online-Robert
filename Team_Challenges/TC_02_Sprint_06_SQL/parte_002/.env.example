# .env.example — copiar este fichero como .env y rellenar los valores.
# El .env real NUNCA se sube al repositorio.
#
# Si estas variables no están configuradas, los notebooks NO fallan: caen
# automáticamente al espejo local de SQLite (ver src/conexion.py).

GCP_PROJECT_ID=tu-proyecto-gcp
BQ_DATASET_ID=voltiatech
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json
